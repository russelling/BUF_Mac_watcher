<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.buffalovfx.qtwatcher</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Unversioned python3 symlink inside Shotgun.app: survives the app's
             bundled-Python version bumps (was python3.11, now python3.13). -->
        <string>/Applications/Shotgun.app/Contents/Resources/Python3/bin/python3</string>
        <string>/Volumes/atv-post-lucid3/atv-buffalo-s03/buffalo_vfx/repo/pipeline/config/flow/alts/BUF_Mac_watcher/scripts/qt_watcher.py</string>
    </array>

    <!-- sgtk is not on the bundled Python's default path; point PYTHONPATH at
         the Toolkit core's python dir so `import sgtk` works under launchd. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/Volumes/atv-post-lucid3/atv-buffalo-s03/buffalo_vfx/repo/pipeline/config/flow/current/install/core/python</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Local logs only: launchd exit 78 is common when StandardOut/Err
         point at a network volume that is slow/unavailable at load time. -->
    <key>StandardOutPath</key>
    <string>/Users/mark.russell/Library/Logs/buffalovfx/qt_watcher.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/mark.russell/Library/Logs/buffalovfx/qt_watcher_error.log</string>

    <key>WorkingDirectory</key>
    <string>/Volumes/atv-post-lucid3/atv-buffalo-s03/buffalo_vfx/repo/pipeline/config/flow/alts/BUF_Mac_watcher/scripts</string>
</dict>
</plist>
