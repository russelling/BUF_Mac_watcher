-- QT Watcher Monitor — application source.
--
-- GENERATED by watcher_monitor/make_monitor_app.sh. Do not edit a built copy;
-- edit this template and rebuild.
--
-- Why AppleScript and not a shell script in Contents/MacOS: a hand-rolled
-- bundle whose main executable is a #!/bin/bash script has no Mach-O header,
-- so LaunchServices has no architecture or platform to check and refuses to
-- launch it -- _LSOpenURLsWithCompletionHandler() failed with error -10669 on
-- M4MM02, 2026-09-22. macOS answers that refusal by offering a system update,
-- which then can't reach Apple, so the user sees "Unable to check for
-- updates" and nothing else. Running the same launcher from Terminal worked
-- throughout, because Terminal never goes through LaunchServices.
--
-- osacompile's applet is Apple's own signed Mach-O, so the bundle launches.
-- The build only replaces its icon; its Info.plist is left exactly as
-- osacompile wrote it.

property launcherPath : "@@LAUNCHER@@"
property sgPython : "@@SG_PYTHON@@"
property logDir : "@@LOG_DIR@@"

on noteProblem(msg)
	display dialog msg with title "QT Watcher Monitor" buttons {"OK"} ¬
		default button "OK" with icon caution
end noteProblem

on pathExists(p)
	return (do shell script "test -e " & quoted form of p & " && echo 1 || echo 0") is "1"
end pathExists

on run
	if not pathExists(launcherPath) then
		noteProblem("Can't reach the pipeline share." & linefeed & linefeed & ¬
			launcherPath & linefeed & linefeed & ¬
			"Mount atv-post-lucid3 and try again.")
		return
	end if

	if not pathExists(sgPython) then
		noteProblem("Flow Production Tracking Desktop isn't installed." & ¬
			linefeed & linefeed & ¬
			"The monitor panel runs on its bundled Python:" & linefeed & ¬
			sgPython & linefeed & linefeed & ¬
			"Install Flow Desktop, sign in once, then try again.")
		return
	end if

	-- do shell script is subject to AppleScript's two-minute command timeout.
	-- Without this block the app would throw a spurious "AppleEvent timed out"
	-- once the panel had been open that long.
	with timeout of 86400 seconds
		try
			do shell script "mkdir -p " & quoted form of logDir & "; " & ¬
				"set -o pipefail; " & quoted form of launcherPath & ¬
				" 2>&1 | tee -a " & quoted form of (logDir & "/monitor_app.log")
		on error errMsg number errNum
			-- -128 is the user cancelling; anything else is worth showing,
			-- since a double-clicked app has nowhere to print.
			if errNum is not -128 then
				noteProblem("The monitor panel exited with an error." & ¬
					linefeed & linefeed & errMsg & linefeed & linefeed & ¬
					"Full output: " & logDir & "/monitor_app.log")
			end if
		end try
	end timeout
end run
